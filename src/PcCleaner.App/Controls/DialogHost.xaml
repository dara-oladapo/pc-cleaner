<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PcCleaner.App.ViewModels"
             x:Class="PcCleaner.App.Controls.DialogHost"
             x:DataType="vm:DialogHostViewModel"
             IsVisible="{Binding IsOpen}"
             InputTransparent="False">

    <!--
      The app's own confirmation dialog. Sits above the page content inside each page's outer Grid,
      invisible until IsOpen. Not DisplayAlert: that draws the operating system's dialog, which ignores
      the design system, differs between Windows and Mac Catalyst, and can't show the manifest below.
    -->

    <Grid>
        <!-- Scrim. Tapping outside the card cancels, which is why Cancel must mean "no". -->
        <BoxView BackgroundColor="{AppThemeBinding Light={StaticResource Scrim}, Dark={StaticResource ScrimDark}}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CancelCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border Style="{StaticResource DialogCard}">
            <VerticalStackLayout Spacing="{StaticResource Space3}">

                <Label Style="{StaticResource EmptyStateTitle}" Text="{Binding Title}" />

                <Label Style="{StaticResource EmptyStateBody}" Text="{Binding Message}" />

                <!-- What is actually about to go. Omitted entirely when the caller has nothing to list. -->
                <Border Style="{StaticResource DialogManifest}" IsVisible="{Binding HasDetails}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Details}" Spacing="3">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Style="{StaticResource Mono}" Text="{Binding .}" LineBreakMode="MiddleTruncation" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <HorizontalStackLayout Spacing="{StaticResource Space2}" HorizontalOptions="End" Margin="0,4,0,0">
                    <Button Text="{Binding CancelText}" Command="{Binding CancelCommand}" />
                    <Button Text="{Binding AcceptText}" Command="{Binding AcceptCommand}"
                            Style="{StaticResource PrimaryButton}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsDestructive}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnDanger}, Dark={StaticResource OnDangerDark}}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
