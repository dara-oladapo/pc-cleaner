<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PcCleaner.Presentation.ViewModels;assembly=PcCleaner.Presentation"
             xmlns:controls="clr-namespace:PcCleaner.App.Controls"
             x:Class="PcCleaner.App.Pages.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="Dashboard"
             Shell.NavBarIsVisible="False">

    <Grid>

    <Grid RowDefinitions="Auto,*,Auto" Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource Space4}">

        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Style="{StaticResource Eyebrow}" Text="This computer" />
            <Label Style="{StaticResource PageTitle}" Text="{Binding DriveNameText}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="{StaticResource Space5}">

                <!--
                  The capacity readout. Avast and CleanMyMac both open on a circular gauge; this goes the
                  other way and draws the actual drive as one honest bar. The reclaimable slice sits against
                  the free segment because that is where it is about to go.
                -->
                <VerticalStackLayout Spacing="{StaticResource Space3}" IsVisible="{Binding HasDriveInfo}">

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Style="{StaticResource HeroNumber}" Text="{Binding ReclaimableText}" />
                            <Label Style="{StaticResource HeroCaption}" Text="{Binding StatusText}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Style="{StaticResource Mono}"
                               Text="{Binding CapacityText}"
                               VerticalOptions="End" />
                    </Grid>

                    <Border Style="{StaticResource CapacityBar}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding OccupiedShare, Converter={StaticResource ShareToStarLengthConverter}}" />
                                <ColumnDefinition Width="{Binding ReclaimableShare, Converter={StaticResource ShareToStarLengthConverter}}" />
                                <ColumnDefinition Width="{Binding FreeShare, Converter={StaticResource ShareToStarLengthConverter}}" />
                            </Grid.ColumnDefinitions>
                            <BoxView Grid.Column="0" Style="{StaticResource SegmentOccupied}" />
                            <BoxView Grid.Column="1" Style="{StaticResource SegmentReclaimable}" />
                            <BoxView Grid.Column="2" Style="{StaticResource SegmentFree}" />
                        </Grid>
                    </Border>

                    <HorizontalStackLayout Spacing="{StaticResource Space5}">
                        <HorizontalStackLayout Spacing="{StaticResource Space2}">
                            <BoxView Style="{StaticResource LegendSwatch}"
                                     BackgroundColor="{AppThemeBinding Light={StaticResource Occupied}, Dark={StaticResource OccupiedDark}}" />
                            <Label Style="{StaticResource MonoNumber}" Text="{Binding OccupiedText}" />
                            <Label Style="{StaticResource Caption}" Text="in use" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="{StaticResource Space2}">
                            <BoxView Style="{StaticResource LegendSwatch}"
                                     BackgroundColor="{AppThemeBinding Light={StaticResource Signal}, Dark={StaticResource SignalDark}}" />
                            <Label Style="{StaticResource MonoNumber}" Text="{Binding ReclaimableText}" />
                            <Label Style="{StaticResource Caption}" Text="reclaimable" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="{StaticResource Space2}">
                            <BoxView Style="{StaticResource LegendSwatch}"
                                     BackgroundColor="{AppThemeBinding Light={StaticResource Sunken}, Dark={StaticResource SunkenDark}}" />
                            <Label Style="{StaticResource MonoNumber}" Text="{Binding FreeText}" />
                            <Label Style="{StaticResource Caption}" Text="free" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Fallback when the drive can't be read: still report the figure, just without the bar. -->
                <VerticalStackLayout Spacing="2" IsVisible="{Binding HasDriveInfo, Converter={StaticResource InvertedBoolConverter}}">
                    <Label Style="{StaticResource Eyebrow}" Text="Reclaimable" />
                    <Label Style="{StaticResource HeroNumber}" Text="{Binding ReclaimableText}" />
                    <Label Style="{StaticResource HeroCaption}" Text="{Binding StatusText}" />
                </VerticalStackLayout>


                <!--
                  Progress. "N of M tools finished" is a real fraction, so the dashboard is the one screen
                  that earns a determinate marker: one per tool in this run. The file count stays a count.
                -->
                <Border Style="{StaticResource ProgressPanel}" IsVisible="{Binding IsBusy}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space4}">
                        <HorizontalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center"
                                               BindableLayout.ItemsSource="{Binding RunSteps}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:DashboardToolViewModel">
                                    <BoxView Style="{StaticResource StepMarker}">
                                        <BoxView.Triggers>
                                            <DataTrigger TargetType="BoxView" Binding="{Binding IsStepDone}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Signal}, Dark={StaticResource SignalDark}}" />
                                            </DataTrigger>
                                        </BoxView.Triggers>
                                    </BoxView>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                        <Label Grid.Column="1" Style="{StaticResource ProgressText}" Text="{Binding ProgressText}" />
                    </Grid>
                </Border>

                <!-- What the last clean did, one line per tool, and anything that could not be done. -->
                <VerticalStackLayout Spacing="{StaticResource Space2}" IsVisible="{Binding HasRunReport}">
                    <Label Style="{StaticResource Eyebrow}" Text="Last run" />
                    <Border Style="{StaticResource Card}" Padding="{StaticResource RowPadding}">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding RunReport}" Spacing="4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Style="{StaticResource Caption}" Text="{Binding .}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!--
                  Tools. The tick decides whether a run scans and cleans the tool at all. "Show" lists the
                  tool's own parts, each with the same tick its page has: one selection, two views onto it.
                -->
                <VerticalStackLayout Spacing="{StaticResource Space3}">
                    <Label Style="{StaticResource Eyebrow}" Text="Tools in this run" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Tools}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:DashboardToolViewModel">
                                <Border Style="{StaticResource Card}" Padding="{StaticResource RowPadding}">
                                    <VerticalStackLayout Spacing="{StaticResource Space3}">

                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="{StaticResource Space3}">

                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsIncluded}" VerticalOptions="Center"
                                                      IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=IsIdle}"
                                                      SemanticProperties.Description="{Binding Title, StringFormat='Include {0} in the run'}" />

                                            <Path Grid.Column="1" Data="{StaticResource IconJunk}"
                                                  Stroke="{AppThemeBinding Light={StaticResource Signal}, Dark={StaticResource SignalDark}}"
                                                  StrokeThickness="1.5" StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="Uniform"
                                                  HeightRequest="17" WidthRequest="17" VerticalOptions="Center">
                                                <Path.Triggers>
                                                    <DataTrigger TargetType="Path" Binding="{Binding Route}" Value="duplicates">
                                                        <Setter Property="Data" Value="{StaticResource IconDuplicates}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Path" Binding="{Binding Route}" Value="large">
                                                        <Setter Property="Data" Value="{StaticResource IconLargeFiles}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Path" Binding="{Binding Route}" Value="cloud">
                                                        <Setter Property="Data" Value="{StaticResource IconCloud}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Path" Binding="{Binding Route}" Value="developer">
                                                        <Setter Property="Data" Value="{StaticResource IconDeveloper}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Path" Binding="{Binding Route}" Value="startup">
                                                        <Setter Property="Data" Value="{StaticResource IconStartup}" />
                                                    </DataTrigger>
                                                </Path.Triggers>
                                            </Path>

                                            <VerticalStackLayout Grid.Column="2" Spacing="3" VerticalOptions="Center">
                                                <Label Style="{StaticResource RowTitle}" Text="{Binding Title}" />
                                                <Label Style="{StaticResource Caption}" Text="{Binding Caption}" />
                                            </VerticalStackLayout>

                                            <Label Grid.Column="3" Style="{StaticResource Mono}" Text="{Binding SummaryText}" VerticalOptions="Center" />

                                            <Button Grid.Column="4" Style="{StaticResource InlineButton}" Text="{Binding ExpandText}"
                                                    Command="{Binding ToggleExpandedCommand}" IsVisible="{Binding HasParts}" VerticalOptions="Center" />

                                            <Button Grid.Column="5" Style="{StaticResource InlineButton}" Text="Open" VerticalOptions="Center"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=OpenToolCommand}"
                                                    CommandParameter="{Binding Route}" />
                                        </Grid>

                                        <VerticalStackLayout IsVisible="{Binding ShowParts}" Spacing="{StaticResource Space2}">
                                            <BoxView Style="{StaticResource RowDivider}" />
                                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Parts}" Spacing="{StaticResource Space2}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:DashboardPartViewModel">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space3}">
                                                            <!-- The slot keeps its width when there is no tick, so titles stay aligned. -->
                                                            <Grid Grid.Column="0" WidthRequest="{StaticResource CheckBoxSize}" VerticalOptions="Center">
                                                                <CheckBox IsChecked="{Binding IsSelected}" IsVisible="{Binding CanSelect}"
                                                                          IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=IsIdle}"
                                                                          SemanticProperties.Description="{Binding Title, StringFormat='Clean {0}'}" />
                                                            </Grid>
                                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                                <Label Style="{StaticResource RowTitle}" Text="{Binding Title}" LineBreakMode="MiddleTruncation" />
                                                                <Label Style="{StaticResource Caption}" Text="{Binding Detail}" IsVisible="{Binding HasDetail}"
                                                                       LineBreakMode="MiddleTruncation" />
                                                            </VerticalStackLayout>
                                                            <Label Grid.Column="2" Style="{StaticResource Mono}" Text="{Binding SizeText}" VerticalOptions="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                            <Label Style="{StaticResource Caption}" Text="{Binding MoreText}" IsVisible="{Binding ShowMore}" />
                                        </VerticalStackLayout>

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!--
                  Every volume Large Files and Duplicates can walk, with the same tick as the Settings page.
                  A ticked volume that isn't connected stays in the list, marked, so it never silently vanishes.
                -->
                <VerticalStackLayout Spacing="{StaticResource Space3}" IsVisible="{Binding HasVolumes}">
                    <VerticalStackLayout Spacing="2">
                        <Label Style="{StaticResource Eyebrow}" Text="Drives and volumes" />
                        <Label Style="{StaticResource Caption}" Text="{Binding VolumesStatusText}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Volumes}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:VolumeChoiceViewModel">
                                <Border Style="{StaticResource Card}" Padding="{StaticResource RowPadding}">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{StaticResource Space3}">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalOptions="Center"
                                                  IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=IsIdle}"
                                                  SemanticProperties.Description="{Binding DisplayName, StringFormat='Scan {0}'}" />
                                        <HorizontalStackLayout Grid.Column="1" Spacing="{StaticResource Space2}" VerticalOptions="Center">
                                            <Label Style="{StaticResource RowTitle}" Text="{Binding DisplayName}" VerticalOptions="Center" />
                                            <Border Style="{StaticResource QuietPill}" IsVisible="{Binding IsAvailable}">
                                                <Label Style="{StaticResource QuietPillLabel}" Text="{Binding KindText}" />
                                            </Border>
                                            <Border Style="{StaticResource AttentionPill}" IsVisible="{Binding IsAvailable, Converter={StaticResource InvertedBoolConverter}}">
                                                <Label Style="{StaticResource AttentionPillLabel}" Text="{Binding KindText}" />
                                            </Border>
                                        </HorizontalStackLayout>
                                        <Grid Grid.Column="2" HorizontalOptions="Start" VerticalOptions="Center" IsVisible="{Binding IsAvailable}">
                                            <BoxView Style="{StaticResource MeterTrack}" />
                                            <BoxView Style="{StaticResource MeterFill}"
                                                     WidthRequest="{Binding UsedShare, Converter={StaticResource ShareToWidthConverter}, ConverterParameter={StaticResource MeterWidth}}" />
                                        </Grid>
                                        <Label Grid.Column="3" Style="{StaticResource Mono}" Text="{Binding SpaceText}" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!--
          One primary action, as everywhere else. The two that remove things are Danger. "Scan and clean"
          asks once, for everything. "Scan and auto clean" is the only action in the app that does not ask,
          and the line under the buttons says so.
        -->
        <VerticalStackLayout Grid.Row="2" Spacing="{StaticResource Space2}">
            <HorizontalStackLayout Spacing="{StaticResource Space3}">
                <Button Text="Scan everything" Style="{StaticResource PrimaryButton}" Command="{Binding ScanEverythingCommand}" />
                <Button Text="Scan and clean" Style="{StaticResource DangerButton}" Command="{Binding ScanAndCleanCommand}" />
                <Button Text="Scan and auto clean" Style="{StaticResource DangerButton}" Command="{Binding ScanAndAutoCleanCommand}" />
                <Button Text="Stop scan" Command="{Binding CancelScanCommand}" IsVisible="{Binding IsScanning}" />
            </HorizontalStackLayout>
            <Label Style="{StaticResource HeroCaption}"
                   Text="Scan everything deletes nothing. Scan and clean asks once before removing what is ticked. Scan and auto clean removes what is ticked without asking." />
        </VerticalStackLayout>

    </Grid>

        <!-- The app's own confirmation dialog. Invisible until a view model asks for one. -->
        <controls:DialogHost />

    </Grid>
</ContentPage>
