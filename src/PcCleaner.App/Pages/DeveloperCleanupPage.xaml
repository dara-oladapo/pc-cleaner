<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PcCleaner.Presentation.ViewModels;assembly=PcCleaner.Presentation"
             xmlns:controls="clr-namespace:PcCleaner.App.Controls"
             x:Class="PcCleaner.App.Pages.DeveloperCleanupPage"
             x:DataType="vm:DeveloperCleanupViewModel"
             Title="Developer"
             Shell.NavBarIsVisible="False">

    <Grid>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource Space4}">

        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Style="{StaticResource Eyebrow}" Text="Selected to clean up" />
            <Label Style="{StaticResource HeroNumber}" Text="{Binding SelectedSizeText}" />
            <Label Style="{StaticResource HeroCaption}" Text="{Binding StatusText}" />
        </VerticalStackLayout>

        <Border Grid.Row="1" Style="{StaticResource ProgressPanel}" IsVisible="{Binding IsScanning}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space3}">
                <ActivityIndicator Grid.Column="0" IsRunning="{Binding IsScanning}" HeightRequest="16" WidthRequest="16" />
                <Label Grid.Column="1" Style="{StaticResource ProgressText}" Text="{Binding StatusText}" />
            </Grid>
        </Border>

        <!-- No "Select all": volumes and worktrees with unusual ignored files should never be one click away. -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="{StaticResource Space2}" IsVisible="{Binding HasScanned}">
            <Button Grid.Column="0" Text="Select defaults" Style="{StaticResource InlineButton}" Command="{Binding SelectDefaultsCommand}" />
            <Button Grid.Column="1" Text="Select none" Style="{StaticResource InlineButton}" Command="{Binding SelectNoneCommand}" />
            <Label Grid.Column="2" Style="{StaticResource Mono}" Text="{Binding SelectionSummary}"
                   HorizontalTextAlignment="End" VerticalOptions="Center" />
        </Grid>

        <CollectionView Grid.Row="3" ItemsSource="{Binding Groups}" IsGrouped="True">

            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="{StaticResource Space3}" VerticalOptions="Center" HorizontalOptions="Start" Padding="0,32">
                    <Path Data="{StaticResource IconSearch}"
                          Stroke="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                          StrokeThickness="1.5" StrokeLineCap="Round" Aspect="Uniform"
                          HeightRequest="28" WidthRequest="28" HorizontalOptions="Start" Opacity="0.7" />
                    <Label Style="{StaticResource EmptyStateTitle}" Text="Nothing scanned yet" />
                    <Label Style="{StaticResource EmptyStateBody}"
                           Text="Scan to measure Docker build cache and images (including engines inside WSL), git worktrees that are clean, pushed and idle, and build output of projects nobody has touched in a month. Nothing is removed until you choose it and confirm." />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="vm:DevCleanupGroup">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space2}" Padding="0,16,0,6">
                        <Label Grid.Column="0" Style="{StaticResource Eyebrow}" Text="{Binding Name}" VerticalOptions="Center" />
                        <BoxView Grid.Column="1" HeightRequest="1" VerticalOptions="Center" />
                        <Label Grid.Column="2" Style="{StaticResource Mono}" Text="{Binding TotalText}" VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:DevCleanupItemViewModel">
                    <Border Style="{StaticResource RowCard}" Margin="0,3">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="{StaticResource Space3}">

                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label Style="{StaticResource RowTitle}" Text="{Binding Title}" />
                                <Label Style="{StaticResource Caption}" Text="{Binding Reason}" />
                                <Label Style="{StaticResource Mono}" Text="{Binding Path}" IsVisible="{Binding HasPath}" LineBreakMode="MiddleTruncation" />
                                <Label Style="{StaticResource Caption}" Text="{Binding Warning}" IsVisible="{Binding HasWarning}"
                                       TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                            </VerticalStackLayout>

                            <Grid Grid.Column="2" VerticalOptions="Center">
                                <Border Style="{StaticResource QuietPill}" IsVisible="{Binding IsNotHighRisk}">
                                    <Label Style="{StaticResource QuietPillLabel}" Text="{Binding RiskText}" />
                                </Border>
                                <Border Style="{StaticResource AttentionPill}" IsVisible="{Binding IsHighRisk}">
                                    <Label Style="{StaticResource AttentionPillLabel}" Text="{Binding RiskText}" />
                                </Border>
                            </Grid>

                            <Grid Grid.Column="3" HorizontalOptions="Start" VerticalOptions="Center">
                                <BoxView Style="{StaticResource MeterTrack}" />
                                <BoxView Style="{StaticResource MeterFill}"
                                         WidthRequest="{Binding ShareOfMax, Converter={StaticResource ShareToWidthConverter}, ConverterParameter={StaticResource MeterWidth}}" />
                            </Grid>

                            <Label Grid.Column="4" Style="{StaticResource MonoNumber}" Text="{Binding SizeText}"
                                   VerticalOptions="Center" MinimumWidthRequest="96" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <VerticalStackLayout Spacing="{StaticResource Space2}" Padding="0,16,0,0">
                    <Label Style="{StaticResource Eyebrow}" Text="Messages from the tools" IsVisible="{Binding HasErrors}" />
                    <CollectionView ItemsSource="{Binding Errors}" IsVisible="{Binding HasErrors}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Style="{StaticResource Mono}" Text="{Binding .}" LineBreakMode="WordWrap" Margin="0,2" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Label Style="{StaticResource Eyebrow}" Text="Good to know" IsVisible="{Binding HasNotes}" />
                    <CollectionView ItemsSource="{Binding Notes}" IsVisible="{Binding HasNotes}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Style="{StaticResource Caption}" Text="{Binding .}" LineBreakMode="WordWrap" Margin="0,2" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </CollectionView.Footer>
        </CollectionView>

        <HorizontalStackLayout Grid.Row="4" Spacing="{StaticResource Space3}">
            <Button Text="Scan" Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" />
            <Button Text="Stop scan" Command="{Binding CancelScanCommand}" IsVisible="{Binding IsScanning}" />
            <Button Text="Clean selected" Style="{StaticResource DangerButton}" Command="{Binding CleanCommand}" />
            <Label Style="{StaticResource HeroCaption}"
                   Text="Docker prunes and worktree removals cannot be undone. You confirm before anything runs."
                   VerticalOptions="Center" />
        </HorizontalStackLayout>

    </Grid>

        <controls:DialogHost />

    </Grid>
</ContentPage>
