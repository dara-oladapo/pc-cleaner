<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PcCleaner.App.ViewModels"
             x:Class="PcCleaner.App.Pages.AboutPage"
             x:DataType="vm:AboutViewModel"
             Title="About">

    <VerticalStackLayout Padding="24,20" Spacing="16">

        <VerticalStackLayout Spacing="2">
            <Label Style="{StaticResource Eyebrow}" Text="PC Cleaner" />
            <Label Style="{StaticResource HeroNumber}" Text="{Binding VersionText}" />
            <Label Style="{StaticResource HeroCaption}" Text="{Binding StatusText}" />
        </VerticalStackLayout>

        <HorizontalStackLayout Spacing="10">
            <Button Text="Check for Updates" Style="{StaticResource PrimaryButton}" Command="{Binding CheckForUpdatesCommand}" />
            <Button Text="Download &amp; Restart" Style="{StaticResource PrimaryButton}" Command="{Binding DownloadAndRestartCommand}" IsVisible="{Binding UpdateReady}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </HorizontalStackLayout>

        <BoxView HeightRequest="1" Opacity="0.6" Margin="0,10" />

        <VerticalStackLayout Spacing="4">
            <Label Style="{StaticResource Eyebrow}" Text="Free and unlocked" />
            <Label Style="{StaticResource Caption}" Text="No paywall, no trial limits, no upsells. Every feature in this app — junk cleanup, duplicate/large file finder, startup manager — is fully functional." />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="4">
            <Label Style="{StaticResource Eyebrow}" Text="Source" />
            <Label Style="{StaticResource Mono}" Text="github.com/dara-oladapo/pc-cleaner" />
        </VerticalStackLayout>

    </VerticalStackLayout>
</ContentPage>
