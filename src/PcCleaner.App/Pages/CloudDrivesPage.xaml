<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PcCleaner.Presentation.ViewModels;assembly=PcCleaner.Presentation"
             xmlns:controls="clr-namespace:PcCleaner.App.Controls"
             x:Class="PcCleaner.App.Pages.CloudDrivesPage"
             x:DataType="vm:CloudDrivesViewModel"
             Title="Cloud Drives"
             Shell.NavBarIsVisible="False">

    <Grid>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource Space4}">

        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Style="{StaticResource Eyebrow}" Text="Selected to free up" />
            <Label Style="{StaticResource HeroNumber}" Text="{Binding SelectedSizeText}" />
            <Label Style="{StaticResource HeroCaption}" Text="{Binding StatusText}" />
            <Label Style="{StaticResource HeroCaption}" Text="{Binding LastRunText}" IsVisible="{Binding HasLastRun}" />
        </VerticalStackLayout>

        <!-- The one thing to understand before using this page. -->
        <Label Grid.Row="1" Style="{StaticResource Caption}"
               Text="Freeing up space makes files online-only. They stay in your cloud storage and in this folder, and download again when you open them. Nothing is deleted. Only files that are fully synced, not set to always stay on this device, not open, and not used for the chosen number of days are included." />

        <Border Grid.Row="2" Style="{StaticResource ProgressPanel}" IsVisible="{Binding IsScanning}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space3}">
                <ActivityIndicator Grid.Column="0" IsRunning="{Binding IsScanning}" HeightRequest="16" WidthRequest="16" />
                <Label Grid.Column="1" Style="{StaticResource ProgressText}" Text="{Binding StatusText}" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="{StaticResource Space2}">
            <Label Grid.Column="0" Style="{StaticResource Caption}" Text="Not used for at least" VerticalOptions="Center" />
            <Picker Grid.Column="1" ItemsSource="{Binding AgeOptions}" SelectedItem="{Binding SelectedAgeDays}"
                    WidthRequest="80" VerticalOptions="Center"
                    SemanticProperties.Description="Minimum number of days since a file was last used" />
            <Label Grid.Column="2" Style="{StaticResource Caption}" Text="days" VerticalOptions="Center" Margin="0,0,12,0" />
            <HorizontalStackLayout Grid.Column="3" Spacing="{StaticResource Space2}" IsVisible="{Binding HasScanned}">
                <Button Text="Select all" Style="{StaticResource InlineButton}" Command="{Binding SelectAllCommand}" />
                <Button Text="Select none" Style="{StaticResource InlineButton}" Command="{Binding SelectNoneCommand}" />
            </HorizontalStackLayout>
            <Label Grid.Column="4" Style="{StaticResource Mono}" Text="{Binding SelectionSummary}" IsVisible="{Binding HasScanned}"
                   HorizontalTextAlignment="End" VerticalOptions="Center" />
        </Grid>

        <CollectionView Grid.Row="4" ItemsSource="{Binding Roots}">

            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="{StaticResource Space3}" VerticalOptions="Center" HorizontalOptions="Start" Padding="0,32">
                    <Path Data="{StaticResource IconCloud}"
                          Stroke="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                          StrokeThickness="1.5" StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="Uniform"
                          HeightRequest="28" WidthRequest="28" HorizontalOptions="Start" Opacity="0.7" />
                    <Label Style="{StaticResource EmptyStateTitle}" Text="Nothing scanned yet" />
                    <Label Style="{StaticResource EmptyStateBody}"
                           Text="Scan to see how much of OneDrive, Dropbox, iCloud Drive and other cloud folders is downloaded to this device, and how much can safely go back to online-only. Nothing changes until you choose it." />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:CloudRootViewModel">
                    <Border Style="{StaticResource RowCard}" Margin="0,3">
                        <VerticalStackLayout Spacing="{StaticResource Space2}">

                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{StaticResource Space3}">
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" VerticalOptions="Center" />

                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Style="{StaticResource RowTitle}" Text="{Binding Title}" />
                                    <Label Style="{StaticResource Mono}" Text="{Binding Path}" LineBreakMode="MiddleTruncation" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding HydratedText}" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding KeptText}" IsVisible="{Binding HasKeptText}" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding ReadOnlyText}" IsVisible="{Binding IsReadOnly}" />
                                </VerticalStackLayout>

                                <Grid Grid.Column="2" HorizontalOptions="Start" VerticalOptions="Center">
                                    <BoxView Style="{StaticResource MeterTrack}" />
                                    <BoxView Style="{StaticResource MeterFill}"
                                             WidthRequest="{Binding ShareOfMax, Converter={StaticResource ShareToWidthConverter}, ConverterParameter={StaticResource MeterWidth}}" />
                                </Grid>

                                <VerticalStackLayout Grid.Column="3" Spacing="2" VerticalOptions="Center" MinimumWidthRequest="96">
                                    <Label Style="{StaticResource MonoNumber}" Text="{Binding EligibleSizeText}" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding EligibleText}" HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                            </Grid>

                            <Button Text="{Binding ExpandText}" Style="{StaticResource InlineButton}" HorizontalOptions="Start"
                                    Command="{Binding ToggleExpandedCommand}" IsVisible="{Binding HasLargestFiles}" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding LargestFiles}" IsVisible="{Binding IsExpanded}" Spacing="2" Padding="36,0,0,0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CloudFileViewModel">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{StaticResource Space3}">
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanToggle}" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                <Label Style="{StaticResource RowTitle}" Text="{Binding Name}" LineBreakMode="MiddleTruncation" />
                                                <Label Style="{StaticResource Mono}" Text="{Binding Folder}" LineBreakMode="MiddleTruncation" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Style="{StaticResource Caption}" Text="{Binding ReasonText}" VerticalOptions="Center" />
                                            <Label Grid.Column="3" Style="{StaticResource MonoNumber}" Text="{Binding SizeText}" VerticalOptions="Center" MinimumWidthRequest="72" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <HorizontalStackLayout Grid.Row="5" Spacing="{StaticResource Space3}">
            <Button Text="Scan" Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" />
            <Button Text="Stop scan" Command="{Binding CancelScanCommand}" IsVisible="{Binding IsScanning}" />
            <!-- Not the Danger style: nothing is deleted, and every file stays in the cloud. -->
            <Button Text="Free up space" Style="{StaticResource PrimaryButton}" Command="{Binding FreeUpCommand}" />
            <Label Style="{StaticResource HeroCaption}"
                   Text="Files stay in the cloud and download again when opened."
                   VerticalOptions="Center" />
        </HorizontalStackLayout>

    </Grid>

        <controls:DialogHost />

    </Grid>
</ContentPage>
