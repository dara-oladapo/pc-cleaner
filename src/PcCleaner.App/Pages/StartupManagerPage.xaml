<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PcCleaner.App.ViewModels"
             x:Class="PcCleaner.App.Pages.StartupManagerPage"
             x:DataType="vm:StartupManagerViewModel"
             Title="Startup Items">

    <Grid RowDefinitions="Auto,Auto,*" Padding="24,20" RowSpacing="16">

        <!-- Hero -->
        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Style="{StaticResource Eyebrow}" Text="Launch at login" />
            <Label Style="{StaticResource HeroNumber}" Text="{Binding ItemCountText}" />
            <Label Style="{StaticResource HeroCaption}" Text="{Binding StatusText}" />
        </VerticalStackLayout>

        <HorizontalStackLayout Grid.Row="1" Spacing="10">
            <Button Text="Reload" Style="{StaticResource PrimaryButton}" Command="{Binding LoadCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </HorizontalStackLayout>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Items}">
            <CollectionView.EmptyView>
                <Label Style="{StaticResource Caption}" Text="No startup items loaded yet. Tap Reload." Margin="0,24" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:StartupItemViewModel">
                    <Grid ColumnDefinitions="*,Auto" Padding="0,12" ColumnSpacing="14">
                        <Grid.Resources>
                            <Style TargetType="BoxView" x:Key="RowDivider">
                                <Setter Property="HeightRequest" Value="1" />
                                <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Hairline}, Dark={StaticResource HairlineDark}}" />
                            </Style>
                        </Grid.Resources>
                        <BoxView Grid.ColumnSpan="2" Style="{StaticResource RowDivider}" VerticalOptions="End" Opacity="0.6" />

                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Style="{StaticResource RowTitle}" Text="{Binding Name}" />
                            <HorizontalStackLayout Spacing="6">
                                <Border Style="{StaticResource Pill}">
                                    <Label Style="{StaticResource PillLabel}" Text="{Binding SourceText}" />
                                </Border>
                                <Border Style="{StaticResource AttentionPill}" IsVisible="{Binding RequiresElevation}">
                                    <Label Style="{StaticResource AttentionPillLabel}" Text="Admin required" />
                                </Border>
                            </HorizontalStackLayout>
                            <Label Style="{StaticResource Mono}" Text="{Binding CommandOrPath}" LineBreakMode="MiddleTruncation" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="End" VerticalOptions="Center">
                            <Label Style="{StaticResource Caption}" Text="{Binding StateText}" HorizontalOptions="End" />
                            <Button Text="{Binding ActionButtonText}" Style="{StaticResource InlineButton}" Clicked="OnToggleClicked" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
