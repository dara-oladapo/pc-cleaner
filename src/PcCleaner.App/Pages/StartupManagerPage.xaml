<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PcCleaner.App.ViewModels"
             xmlns:controls="clr-namespace:PcCleaner.App.Controls"
             x:Class="PcCleaner.App.Pages.StartupManagerPage"
             x:DataType="vm:StartupManagerViewModel"
             Title="Startup"
             Shell.NavBarIsVisible="False">

    <Grid>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource Space4}">

        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Style="{StaticResource Eyebrow}" Text="Launch at login" />
            <Label Style="{StaticResource HeroNumber}" Text="{Binding ItemCountText}" />
            <Label Style="{StaticResource HeroCaption}" Text="{Binding StatusText}" />
        </VerticalStackLayout>

        <Border Grid.Row="1" Style="{StaticResource ProgressPanel}" IsVisible="{Binding IsBusy}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space3}">
                <ActivityIndicator Grid.Column="0" IsRunning="{Binding IsBusy}" HeightRequest="16" WidthRequest="16" />
                <Label Grid.Column="1" Style="{StaticResource ProgressText}" Text="{Binding StatusText}" />
            </Grid>
        </Border>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Items}">

            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="{StaticResource Space3}" VerticalOptions="Center" HorizontalOptions="Start" Padding="0,32">
                    <Path Data="{StaticResource IconStartup}"
                          Stroke="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                          StrokeThickness="1.5" StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="Uniform"
                          HeightRequest="28" WidthRequest="28" HorizontalOptions="Start" Opacity="0.7" />
                    <Label Style="{StaticResource EmptyStateTitle}" Text="Nothing loaded yet" />
                    <Label Style="{StaticResource EmptyStateBody}"
                           Text="Load to see the apps and services that start with your computer. Disabling one is reversible and never uninstalls anything." />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:StartupItemViewModel">
                    <Border Style="{StaticResource RowCard}" Margin="0,3">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource Space3}">

                            <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="{StaticResource Space2}">
                                    <Label Style="{StaticResource RowTitle}" Text="{Binding Name}" VerticalOptions="Center" />
                                    <Border Style="{StaticResource Pill}">
                                        <Label Style="{StaticResource PillLabel}" Text="{Binding SourceText}" />
                                    </Border>
                                    <Border Style="{StaticResource AttentionPill}" IsVisible="{Binding RequiresElevation}">
                                        <Label Style="{StaticResource AttentionPillLabel}" Text="Needs admin" />
                                    </Border>
                                </HorizontalStackLayout>
                                <Label Style="{StaticResource Mono}" Text="{Binding CommandOrPath}" LineBreakMode="MiddleTruncation" />
                            </VerticalStackLayout>

                            <!-- Enabled reads as Signal, disabled as a neutral. The trigger is repeated on the
                                 label because MAUI's visual/data triggers only set properties on the element
                                 that declares them — they can't reach a child. -->
                            <Border Grid.Column="1" Style="{StaticResource QuietPill}" VerticalOptions="Center">
                                <Label Style="{StaticResource QuietPillLabel}" Text="{Binding StateText}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsEnabled}" Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Signal}, Dark={StaticResource SignalDark}}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsEnabled}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SignalMuted}, Dark={StaticResource SignalMutedDark}}" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>

                            <!-- ToggleCommand already takes the row's item, so no Clicked handler is needed. -->
                            <Button Grid.Column="2" Text="{Binding ActionButtonText}" Style="{StaticResource InlineButton}"
                                    VerticalOptions="Center"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StartupManagerViewModel}}, Path=ToggleCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <HorizontalStackLayout Grid.Row="3" Spacing="{StaticResource Space3}">
            <Button Text="Reload" Style="{StaticResource PrimaryButton}" Command="{Binding LoadCommand}" />
            <Label Style="{StaticResource HeroCaption}"
                   Text="Read fresh from the registry and the Startup folder each time you reload."
                   VerticalOptions="Center" />
        </HorizontalStackLayout>

    </Grid>

        <!-- The app's own confirmation dialog. Invisible until a view model asks for one. -->
        <controls:DialogHost />

    </Grid>
</ContentPage>
