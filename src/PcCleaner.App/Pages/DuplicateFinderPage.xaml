<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PcCleaner.App.ViewModels"
             x:Class="PcCleaner.App.Pages.DuplicateFinderPage"
             x:DataType="vm:DuplicateFinderViewModel"
             Title="Duplicates &amp; Large Files">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="24,20" RowSpacing="16">

        <!-- Hero -->
        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Style="{StaticResource Eyebrow}" Text="Reclaimable from selected copies" />
            <Label Style="{StaticResource HeroNumber}" Text="{Binding ReclaimableText}" />
            <Label Style="{StaticResource HeroCaption}" Text="{Binding StatusText}" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <Label Style="{StaticResource Eyebrow}" Text="Folders to scan" />
            <CollectionView ItemsSource="{Binding RootPaths}" HeightRequest="84">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Grid ColumnDefinitions="*,Auto" Padding="0,5">
                            <Label Grid.Column="0" Style="{StaticResource Mono}" Text="{Binding .}" LineBreakMode="MiddleTruncation" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Remove" Style="{StaticResource InlineButton}" Clicked="OnRemoveFolderClicked" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Placeholder="Paste a folder path..." Text="{Binding NewFolderPath}" />
                <Button Grid.Column="1" Text="Add" Command="{Binding AddFolderCommand}" />
            </Grid>
        </VerticalStackLayout>

        <HorizontalStackLayout Grid.Row="2" Spacing="10">
            <Button Text="Scan" Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" />
            <Button Text="Cancel" Command="{Binding CancelScanCommand}" IsVisible="{Binding IsScanning}" />
            <ActivityIndicator IsRunning="{Binding IsScanning}" IsVisible="{Binding IsScanning}" />
        </HorizontalStackLayout>

        <CollectionView Grid.Row="3" ItemsSource="{Binding Groups}">
            <CollectionView.EmptyView>
                <Label Style="{StaticResource Caption}" Text="No results yet. Tap Scan to look for duplicate files in the folders above." Margin="0,24" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:DuplicateGroupViewModel">
                    <Border Padding="14" Margin="0,5">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Style="{StaticResource RowTitle}" Text="{Binding SizeEachText, StringFormat='{0} each, duplicated'}" />
                            </Grid>
                            <Grid HorizontalOptions="Start">
                                <BoxView Style="{StaticResource MeterTrack}" WidthRequest="120" />
                                <BoxView Style="{StaticResource MeterFill}"
                                         WidthRequest="{Binding ShareOfMax, Converter={StaticResource ShareToWidthConverter}, ConverterParameter='120'}" />
                            </Grid>
                            <CollectionView ItemsSource="{Binding Files}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FileEntryViewModel">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,4" ColumnSpacing="10">
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding Path}" LineBreakMode="MiddleTruncation" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Style="{StaticResource MonoNumber}" Text="{Binding SizeText}" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="4" Text="Delete Selected" Style="{StaticResource PrimaryButton}" Command="{Binding DeleteSelectedCommand}" HorizontalOptions="Fill" />

    </Grid>
</ContentPage>
