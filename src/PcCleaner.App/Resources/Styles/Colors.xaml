<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
      PC Cleaner colour tokens, taken from the WiseLead design system (Threshold, tokens 0.14.0 and later).
      The values are the design system's; the keys keep this app's own role names so no style had to change.
      Each key says which design-system token it mirrors, so moving to the design-system package later is a
      mechanical swap of key for key.

      One blue does all the work: Blue Two. It is spent on the primary action and on "how much space will I
      get back" numbers. Products differ by mark and name only, never by accent colour.

      Danger is the single deliberate exception, and it earns it: it appears only on a confirmation's
      affirmative button and on destructive-action buttons, so "look" and "cannot be undone" are never the
      same colour. See DESIGN.md for the reasoning.

      Values marked "derived" are not design-system tokens; they are tints of one, chosen for a pill
      background that keeps the text above 4.5:1.
    -->

    <!-- Light -->
    <!-- WlBgDefault -->
    <Color x:Key="Paper">#FAF7F2</Color>
    <!-- WlBgElevated -->
    <Color x:Key="Surface">#FEFCF8</Color>
    <!-- WlBgSunken: recessed fill for meter tracks, wells and hover states. Cards sit above it. -->
    <Color x:Key="Sunken">#F1EBE1</Color>
    <!-- WlInk (Blue One) -->
    <Color x:Key="InkStrong">#1F1C4E</Color>
    <!-- WlInkSoft -->
    <Color x:Key="InkMuted">#5A5478</Color>
    <!-- WlBorderDefault -->
    <Color x:Key="Hairline">#E4DCCE</Color>
    <!-- WlCyanDeep (Blue Two): the primary colour -->
    <Color x:Key="Signal">#1C65AF</Color>
    <!-- derived: Blue Two at about 12% over white -->
    <Color x:Key="SignalMuted">#E3EEF8</Color>
    <!-- WlAmberDeep: amber as text on paper -->
    <Color x:Key="Attention">#9A5A1F</Color>
    <!-- derived: Amber at about 15% over paper -->
    <Color x:Key="AttentionMuted">#F6E9D8</Color>
    <!-- WlDanger (Red) -->
    <Color x:Key="Danger">#B4442F</Color>
    <Color x:Key="OnSignal">#FFFFFF</Color>
    <Color x:Key="OnDanger">#FFFFFF</Color>
    <!-- The "already in use" portion of the drive on the capacity readout. WlNeutral400. -->
    <Color x:Key="Occupied">#A9A2B8</Color>
    <!-- Dialog scrim. WlInkDeep at about 55%, so the dimmed page keeps the palette's cast. -->
    <Color x:Key="Scrim">#8C141238</Color>

    <!-- Dark (the design system's ink theme, mirrored rather than inverted) -->
    <!-- WlBgDefaultDark -->
    <Color x:Key="PaperDark">#141238</Color>
    <!-- WlBgElevatedDark -->
    <Color x:Key="SurfaceDark">#1A1844</Color>
    <!-- WlBgSunkenDark -->
    <Color x:Key="SunkenDark">#0E0D2C</Color>
    <!-- WlFgPrimaryDark -->
    <Color x:Key="InkStrongDark">#F4F1EA</Color>
    <!-- WlFgMutedDark -->
    <Color x:Key="InkMutedDark">#A9A2B8</Color>
    <!-- WlBorderDefaultDark: Paper at 12% -->
    <Color x:Key="HairlineDark">#1FFAF7F2</Color>
    <!-- WlCyan (Blue Three): the primary colour on dark -->
    <Color x:Key="SignalDark">#2699D3</Color>
    <!-- WlPaperWarmDark -->
    <Color x:Key="SignalMutedDark">#1F1C4E</Color>
    <!-- WlWarningDark -->
    <Color x:Key="AttentionDark">#E8A94E</Color>
    <!-- derived -->
    <Color x:Key="AttentionMutedDark">#3A2F1C</Color>
    <!-- WlDangerDark -->
    <Color x:Key="DangerDark">#E0715C</Color>
    <!-- WlFgOnBrandDark: text on a Blue Three fill -->
    <Color x:Key="OnSignalDark">#141238</Color>
    <Color x:Key="OnDangerDark">#21100E</Color>
    <!-- WlNeutral600 -->
    <Color x:Key="OccupiedDark">#5A5478</Color>
    <!-- WlBgSunkenDark at about 65% -->
    <Color x:Key="ScrimDark">#A60E0D2C</Color>

</ResourceDictionary>
