<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
      Icon geometry, drawn on a 20x20 grid.

      These are Geometry resources for Microsoft.Maui.Controls.Shapes.Path rather than image assets, for
      one reason: a Path takes its Stroke from a binding, so a single icon follows the theme and the
      selected/unselected state of a nav item. A MauiImage SVG is baked to a PNG at build time and cannot
      be tinted, which would mean four copies of every icon (light/dark x selected/unselected). No icon
      font, no NuGet package.

      They share a visual family with the app mark in Resources/AppIcon/appiconfg.svg — single-weight
      strokes, flat terminals, geometry over illustration. Draw new ones on the same 20x20 grid.
    -->

    <!-- Three ascending bars sharing a baseline: the app mark, reused for the overview. -->
    <PathGeometry x:Key="IconDashboard" Figures="M4,16 L4,12 M10,16 L10,8 M16,16 L16,4" />

    <!-- Waste bin: junk is deleted permanently, so the icon says bin, not broom. -->
    <PathGeometry x:Key="IconJunk" Figures="M3.5,6 L16.5,6 M8,6 L8,4 L12,4 L12,6 M5.5,6 L6.3,16.5 L13.7,16.5 L14.5,6" />

    <!-- Two offset squares: the same thing, twice. -->
    <PathGeometry x:Key="IconDuplicates" Figures="M7.5,3.5 L16.5,3.5 L16.5,12.5 M3.5,7.5 L12.5,7.5 L12.5,16.5 L3.5,16.5 Z" />

    <!-- A document with a folded corner and a fill line — a file, weighed. -->
    <PathGeometry x:Key="IconLargeFiles" Figures="M5,2.5 L11.5,2.5 L15.5,6.5 L15.5,17.5 L5,17.5 Z M11.5,2.5 L11.5,6.5 L15.5,6.5 M7.5,13.5 L13,13.5" />

    <!-- An open-topped box with something leaving it: apps launching at login. -->
    <PathGeometry x:Key="IconStartup" Figures="M4,4 L4,16 L16,16 L16,4 M10,13 L10,3.5 M7,6.5 L10,3.5 L13,6.5" />

    <!-- Circle drawn as two half-arcs so the sweep direction is unambiguous. -->
    <PathGeometry x:Key="IconAbout" Figures="M2.8,10 A7.2,7.2 0 0 1 17.2,10 A7.2,7.2 0 0 1 2.8,10 M10,9.2 L10,13.6 M10,6.4 L10,7" />

    <!-- Empty-state illustration -->
    <PathGeometry x:Key="IconSearch" Figures="M3.5,9 A5.5,5.5 0 0 1 14.5,9 A5.5,5.5 0 0 1 3.5,9 M13,13 L17,17" />

    <!-- Theme switcher. A display for "follow the system", then sun and moon for the two overrides. -->
    <PathGeometry x:Key="IconThemeSystem" Figures="M3,4.5 L17,4.5 L17,13.5 L3,13.5 Z M10,13.5 L10,16.5 M7.5,16.5 L12.5,16.5" />
    <PathGeometry x:Key="IconThemeLight" Figures="M6,10 A4,4 0 0 1 14,10 A4,4 0 0 1 6,10 M10,2.4 L10,3.9 M10,16.1 L10,17.6 M2.4,10 L3.9,10 M16.1,10 L17.6,10 M4.6,4.6 L5.7,5.7 M14.3,14.3 L15.4,15.4 M15.4,4.6 L14.3,5.7 M5.7,14.3 L4.6,15.4" />
    <!-- Crescent as two arcs with opposite sweeps, so the direction is unambiguous. -->
    <PathGeometry x:Key="IconThemeDark" Figures="M12,3.2 A7,7 0 1 0 12,16.8 A5.6,5.6 0 1 1 12,3.2 Z" />

</ResourceDictionary>
