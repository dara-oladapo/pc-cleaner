<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PcCleaner.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:PcCleaner.App.Pages"
    xmlns:controls="clr-namespace:PcCleaner.App.Controls"
    xmlns:vm="clr-namespace:PcCleaner.App.ViewModels"
    xmlns:services="clr-namespace:PcCleaner.App.Services"
    Title="PC Cleaner"
    FlyoutBehavior="Locked"
    FlyoutWidth="{StaticResource RailWidth}"
    FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">

    <!--
      A locked flyout, not a TabBar. The old bottom tab bar is a phone pattern: on a 1120px desktop
      window it wasted the full width on four labels and gave no room to name a fifth tool. A rail also
      lets the app open on a Dashboard without that landing screen costing a tab.
    -->

    <Shell.FlyoutHeader>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="24,24,16,24">
            <Border Grid.Column="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Signal}, Dark={StaticResource SignalDark}}"
                    Stroke="Transparent"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 4"
                    HeightRequest="26"
                    WidthRequest="26"
                    Padding="0">
                <Path Data="{StaticResource IconDashboard}"
                      Stroke="{AppThemeBinding Light={StaticResource OnSignal}, Dark={StaticResource OnSignalDark}}"
                      StrokeThickness="1.8"
                      StrokeLineCap="Round"
                      Aspect="Uniform"
                      HeightRequest="{StaticResource IconSizeSmall}"
                      WidthRequest="{StaticResource IconSizeSmall}"
                      HorizontalOptions="Center"
                      VerticalOptions="Center" />
            </Border>
            <Label Grid.Column="1"
                   Text="PC Cleaner"
                   FontFamily="DisplayBold"
                   FontSize="{StaticResource FontBody}"
                   VerticalOptions="Center" />
        </Grid>
    </Shell.FlyoutHeader>

    <!--
      Theme switcher. Lives in the rail footer because it is a setting you set once and then stop thinking
      about — it should be reachable from anywhere without spending a nav destination on it.
    -->
    <Shell.FlyoutFooter>
        <Grid x:Name="FlyoutFooterRoot" x:DataType="vm:ThemeViewModel" Padding="12,8,12,16" RowSpacing="6" RowDefinitions="Auto,Auto">

            <Label Grid.Row="0" Style="{StaticResource Eyebrow}" Text="Appearance" Margin="3,0,0,0" />

            <Border Grid.Row="1" Style="{StaticResource ThemeSwitcher}">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="2">

                    <Border Grid.Column="0" Style="{StaticResource ThemeSegment}">
                        <Grid>
                            <Path Data="{StaticResource IconThemeSystem}"
                                  Stroke="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                                  StrokeThickness="1.4" StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="Uniform"
                                  HeightRequest="16" WidthRequest="16"
                                  HorizontalOptions="Center" VerticalOptions="Center">
                                <Path.Triggers>
                                    <DataTrigger TargetType="Path" Binding="{Binding IsSystem}" Value="True">
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Signal}, Dark={StaticResource SignalDark}}" />
                                    </DataTrigger>
                                </Path.Triggers>
                            </Path>
                            <Button Style="{StaticResource ThemeSegmentHit}"
                                    Command="{Binding ChooseCommand}"
                                    CommandParameter="{x:Static services:ThemePreference.System}"
                                    SemanticProperties.Description="Match the system theme" />
                        </Grid>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSystem}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
                            </DataTrigger>
                        </Border.Triggers>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource ThemeSegment}">
                        <Grid>
                            <Path Data="{StaticResource IconThemeLight}"
                                  Stroke="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                                  StrokeThickness="1.4" StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="Uniform"
                                  HeightRequest="16" WidthRequest="16"
                                  HorizontalOptions="Center" VerticalOptions="Center">
                                <Path.Triggers>
                                    <DataTrigger TargetType="Path" Binding="{Binding IsLight}" Value="True">
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Signal}, Dark={StaticResource SignalDark}}" />
                                    </DataTrigger>
                                </Path.Triggers>
                            </Path>
                            <Button Style="{StaticResource ThemeSegmentHit}"
                                    Command="{Binding ChooseCommand}"
                                    CommandParameter="{x:Static services:ThemePreference.Light}"
                                    SemanticProperties.Description="Always use the light theme" />
                        </Grid>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsLight}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
                            </DataTrigger>
                        </Border.Triggers>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource ThemeSegment}">
                        <Grid>
                            <Path Data="{StaticResource IconThemeDark}"
                                  Stroke="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}"
                                  StrokeThickness="1.4" StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="Uniform"
                                  HeightRequest="16" WidthRequest="16"
                                  HorizontalOptions="Center" VerticalOptions="Center">
                                <Path.Triggers>
                                    <DataTrigger TargetType="Path" Binding="{Binding IsDark}" Value="True">
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Signal}, Dark={StaticResource SignalDark}}" />
                                    </DataTrigger>
                                </Path.Triggers>
                            </Path>
                            <Button Style="{StaticResource ThemeSegmentHit}"
                                    Command="{Binding ChooseCommand}"
                                    CommandParameter="{x:Static services:ThemePreference.Dark}"
                                    SemanticProperties.Description="Always use the dark theme" />
                        </Grid>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsDark}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
                            </DataTrigger>
                        </Border.Triggers>
                    </Border>

                </Grid>
            </Border>
        </Grid>
    </Shell.FlyoutFooter>

    <!--
      Selection is shown as a tinted background on the row. MAUI hands the "Selected" visual state to the
      template's root element only, and its VSM setters can't reach a child, so the icon and label keep a
      single colour rather than tinting with the row. The tint alone is unambiguous.
    -->
    <Shell.ItemTemplate>
        <DataTemplate x:DataType="controls:IconFlyoutItem">
            <Border Margin="8,1"
                    Padding="12,9"
                    Stroke="Transparent"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 4"
                    BackgroundColor="Transparent">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Path Grid.Column="0"
                          Data="{Binding IconData}"
                          Stroke="{AppThemeBinding Light={StaticResource InkStrong}, Dark={StaticResource InkStrongDark}}"
                          StrokeThickness="1.5"
                          StrokeLineCap="Round"
                          StrokeLineJoin="Round"
                          Aspect="Uniform"
                          HeightRequest="{StaticResource IconSize}"
                          WidthRequest="{StaticResource IconSize}"
                          VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="{Binding Title}"
                           Style="{StaticResource NavItemLabel}" />
                </Grid>

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Sunken}, Dark={StaticResource SunkenDark}}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SignalMuted}, Dark={StaticResource SignalMutedDark}}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Border>
        </DataTemplate>
    </Shell.ItemTemplate>

    <controls:IconFlyoutItem Title="Dashboard" Route="dashboard" IconData="{StaticResource IconDashboard}">
        <ShellContent ContentTemplate="{DataTemplate pages:DashboardPage}" />
    </controls:IconFlyoutItem>

    <controls:IconFlyoutItem Title="Junk Files" Route="junk" IconData="{StaticResource IconJunk}">
        <ShellContent ContentTemplate="{DataTemplate pages:JunkCleanupPage}" />
    </controls:IconFlyoutItem>

    <controls:IconFlyoutItem Title="Duplicates" Route="duplicates" IconData="{StaticResource IconDuplicates}">
        <ShellContent ContentTemplate="{DataTemplate pages:DuplicateFinderPage}" />
    </controls:IconFlyoutItem>

    <controls:IconFlyoutItem Title="Large Files" Route="large" IconData="{StaticResource IconLargeFiles}">
        <ShellContent ContentTemplate="{DataTemplate pages:LargeFilesPage}" />
    </controls:IconFlyoutItem>

    <controls:IconFlyoutItem Title="Startup" Route="startup" IconData="{StaticResource IconStartup}">
        <ShellContent ContentTemplate="{DataTemplate pages:StartupManagerPage}" />
    </controls:IconFlyoutItem>

    <controls:IconFlyoutItem Title="About" Route="about" IconData="{StaticResource IconAbout}">
        <ShellContent ContentTemplate="{DataTemplate pages:AboutPage}" />
    </controls:IconFlyoutItem>

</Shell>
