<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <!-- See https://aka.ms/maui-publish-app-store#add-entitlements for more information about adding entitlements.-->
    <dict>
        <!--
          App Sandbox is OFF and intentionally so: a system cleaner needs to read/delete cache & log files
          belonging to other apps, manage LaunchAgents/LaunchDaemons outside its own container, and (with the
          user's consent via Full Disk Access in System Settings) scan arbitrary folders for duplicates/large
          files. None of that is possible inside the sandbox. This is standard for this app category (CleanMyMac,
          DaisyDisk, OnyX are all unsandboxed) and means this app must be notarized and distributed directly,
          NOT through the Mac App Store, which requires App Sandbox = true.
        -->
        <key>com.apple.security.app-sandbox</key>
        <false/>

        <!--
          Hardened-runtime exceptions the .NET runtime needs. Notarization requires the hardened runtime,
          and the release workflow passes this file to vpk's signEntitlements option when it signs, so
          without these the signed build would be killed the first time the runtime JITs code. These are
          the set Microsoft documents for .NET on macOS:
          https://learn.microsoft.com/dotnet/core/install/macos-notarization-issues
          They have no effect on an unsigned/ad-hoc build.
        -->
        <key>com.apple.security.cs.allow-jit</key>
        <true/>
        <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
        <true/>
        <key>com.apple.security.cs.disable-library-validation</key>
        <true/>
    </dict>
</plist>

