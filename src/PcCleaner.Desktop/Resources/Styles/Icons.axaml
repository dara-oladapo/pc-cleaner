<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Icon geometry, drawn on a 20x20 grid. The Avalonia port of src/PcCleaner.App/Resources/Styles/Icons.xaml:
    the path data is copied character for character, so the two front ends draw the same marks.

    Geometry rather than image assets for the same reason as on MAUI: a Path takes its Stroke from a style, so one
    icon follows the theme and the selected/unselected state of a rail row. Here they are StreamGeometry, Avalonia's
    parsed-from-path-markup geometry (MAUI's PathGeometry Figures="..." is the same mini-language).

    Single-weight strokes, flat terminals, geometry over illustration. Draw new ones on the same grid, in both files.
  -->

  <!-- Three ascending bars sharing a baseline: the app mark, reused for the overview. -->
  <StreamGeometry x:Key="IconDashboard">M4,16 L4,12 M10,16 L10,8 M16,16 L16,4</StreamGeometry>

  <!-- Waste bin: junk is deleted permanently, so the icon says bin, not broom. -->
  <StreamGeometry x:Key="IconJunk">M3.5,6 L16.5,6 M8,6 L8,4 L12,4 L12,6 M5.5,6 L6.3,16.5 L13.7,16.5 L14.5,6</StreamGeometry>

  <!-- Two offset squares: the same thing, twice. -->
  <StreamGeometry x:Key="IconDuplicates">M7.5,3.5 L16.5,3.5 L16.5,12.5 M3.5,7.5 L12.5,7.5 L12.5,16.5 L3.5,16.5 Z</StreamGeometry>

  <!-- A document with a folded corner and a fill line — a file, weighed. -->
  <StreamGeometry x:Key="IconLargeFiles">M5,2.5 L11.5,2.5 L15.5,6.5 L15.5,17.5 L5,17.5 Z M11.5,2.5 L11.5,6.5 L15.5,6.5 M7.5,13.5 L13,13.5</StreamGeometry>

  <!-- An open-topped box with something leaving it: apps launching at login. -->
  <StreamGeometry x:Key="IconStartup">M4,4 L4,16 L16,16 L16,4 M10,13 L10,3.5 M7,6.5 L10,3.5 L13,6.5</StreamGeometry>

  <!-- Circle drawn as two half-arcs so the sweep direction is unambiguous. -->
  <StreamGeometry x:Key="IconAbout">M2.8,10 A7.2,7.2 0 0 1 17.2,10 A7.2,7.2 0 0 1 2.8,10 M10,9.2 L10,13.6 M10,6.4 L10,7</StreamGeometry>

  <!-- Empty-state illustration -->
  <StreamGeometry x:Key="IconSearch">M3.5,9 A5.5,5.5 0 0 1 14.5,9 A5.5,5.5 0 0 1 3.5,9 M13,13 L17,17</StreamGeometry>

  <!-- Theme switcher. A display for "follow the system", then sun and moon for the two overrides. -->
  <StreamGeometry x:Key="IconThemeSystem">M3,4.5 L17,4.5 L17,13.5 L3,13.5 Z M10,13.5 L10,16.5 M7.5,16.5 L12.5,16.5</StreamGeometry>
  <StreamGeometry x:Key="IconThemeLight">M6,10 A4,4 0 0 1 14,10 A4,4 0 0 1 6,10 M10,2.4 L10,3.9 M10,16.1 L10,17.6 M2.4,10 L3.9,10 M16.1,10 L17.6,10 M4.6,4.6 L5.7,5.7 M14.3,14.3 L15.4,15.4 M15.4,4.6 L14.3,5.7 M5.7,14.3 L4.6,15.4</StreamGeometry>
  <!-- Crescent as two arcs with opposite sweeps, so the direction is unambiguous. -->
  <StreamGeometry x:Key="IconThemeDark">M12,3.2 A7,7 0 1 0 12,16.8 A5.6,5.6 0 1 1 12,3.2 Z</StreamGeometry>

</ResourceDictionary>
