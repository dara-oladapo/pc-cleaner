<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pvm="using:PcCleaner.Presentation.ViewModels"
             xmlns:views="using:PcCleaner.Desktop.Views"
             x:Class="PcCleaner.Desktop.Views.DuplicateFinderView"
             x:DataType="pvm:DuplicateFinderViewModel">

  <!-- The Avalonia port of src/PcCleaner.App/Pages/DuplicateFinderPage.xaml, bound to the same view model. -->
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="{StaticResource Space4}" Margin="{StaticResource PagePadding}">

    <StackPanel Grid.Row="0" Spacing="2">
      <TextBlock Classes="eyebrow" Text="SELECTED TO REMOVE" />
      <TextBlock Classes="hero" Text="{Binding ReclaimableText}" />
      <TextBlock Classes="heroCaption" Text="{Binding StatusText}" />
    </StackPanel>

    <views:ScanRootsView Grid.Row="1" />

    <Border Grid.Row="2" Classes="progressPanel" IsVisible="{Binding IsScanning}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space3}">
        <ProgressBar Grid.Column="0" Classes="activity" />
        <TextBlock Grid.Column="1" Classes="mono" Text="{Binding StatusText}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space2}" IsVisible="{Binding HasScanned}">
      <Button Grid.Column="0" Classes="inline" Content="Select none" Command="{Binding SelectNoneCommand}" />
      <TextBlock Grid.Column="1" Classes="mono" Text="{Binding SelectionSummary}"
                 TextAlignment="Right" VerticalAlignment="Center" />
    </Grid>

    <Panel Grid.Row="4">
      <StackPanel Spacing="{StaticResource Space3}" Margin="0,32" MaxWidth="560"
                  HorizontalAlignment="Left" VerticalAlignment="Center"
                  IsVisible="{Binding !Groups.Count}">
        <Path Classes="icon empty" Data="{StaticResource IconDuplicates}" />
        <TextBlock Classes="emptyTitle" Text="Nothing scanned yet" />
        <TextBlock Classes="emptyBody"
                   Text="Scan to group files with identical contents. One copy in each group is always left unselected, so you keep at least one." />
      </StackPanel>

      <ScrollViewer IsVisible="{Binding !!Groups.Count}" Padding="0,0,12,0">
        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="pvm:DuplicateGroupViewModel">
              <Border Classes="card" Margin="0,4">
                <StackPanel Spacing="{StaticResource Space2}">

                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource Space3}">
                    <TextBlock Grid.Column="0" Classes="rowTitle" VerticalAlignment="Center"
                               Text="{Binding SizeEachText, StringFormat='{}{0} each, duplicated'}" />
                    <Panel Grid.Column="1" VerticalAlignment="Center">
                      <Border Classes="meterTrack" />
                      <Border Classes="meterFill"
                              Width="{Binding ShareOfMax, Converter={StaticResource ShareToWidthConverter}, ConverterParameter={StaticResource MeterWidth}}" />
                    </Panel>
                    <TextBlock Grid.Column="2" Classes="monoNumber" Text="{Binding SizeEachText}"
                               VerticalAlignment="Center" MinWidth="72" />
                  </Grid>

                  <Border Classes="divider" />

                  <ItemsControl ItemsSource="{Binding Files}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="pvm:FileEntryViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space2}" Margin="0,2">
                          <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding Path}" />
                          <TextBlock Grid.Column="1" Classes="mono path" Text="{Binding Path}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Classes="monoNumber" Text="{Binding SizeText}"
                                     VerticalAlignment="Center" MinWidth="72" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Panel>

    <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="{StaticResource Space3}">
      <Button Classes="primary" Content="Scan" Command="{Binding ScanCommand}" />
      <Button Content="Stop scan" Command="{Binding CancelScanCommand}" IsVisible="{Binding IsScanning}" />
      <Button Classes="primary danger" Content="Move selected to Trash" Command="{Binding DeleteSelectedCommand}" />
    </StackPanel>

  </Grid>
</UserControl>
