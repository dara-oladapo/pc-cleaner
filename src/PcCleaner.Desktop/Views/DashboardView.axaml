<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pvm="using:PcCleaner.Presentation.ViewModels"
             x:Class="PcCleaner.Desktop.Views.DashboardView"
             x:DataType="pvm:DashboardViewModel"
             x:Name="Root">

  <!-- The Avalonia port of src/PcCleaner.App/Pages/DashboardPage.xaml, bound to the same DashboardViewModel. -->
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource Space4}" Margin="{StaticResource PagePadding}">

    <StackPanel Grid.Row="0" Spacing="2">
      <TextBlock Classes="eyebrow" Text="THIS COMPUTER" />
      <TextBlock Classes="pageTitle" Text="{Binding DriveNameText}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="{StaticResource Space5}">

        <!--
          The capacity readout. Avast and CleanMyMac both open on a circular gauge; this goes the other way and
          draws the actual drive as one honest bar. The reclaimable slice sits against the free segment because
          that is where it is about to go.
        -->
        <StackPanel Spacing="{StaticResource Space3}" IsVisible="{Binding HasDriveInfo}">

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Classes="hero" Text="{Binding ReclaimableText}" />
              <TextBlock Classes="heroCaption" Text="{Binding StatusText}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Classes="mono" Text="{Binding CapacityText}" VerticalAlignment="Bottom" />
          </Grid>

          <!--
            Three star-width columns, one per segment, so the bar divides whatever width it has by the drive's real
            proportions. The widths are set from code-behind (see DashboardView.axaml.cs): an Avalonia
            ColumnDefinition isn't in the logical tree, so it has no DataContext for a binding to read.
            The columns start at 0 wide: until the view model says otherwise, the bar is an empty Sunken track.
          -->
          <Border Classes="capacityBar">
            <Grid x:Name="CapacitySegments" ColumnDefinitions="0,0,0">
              <Border Grid.Column="0" Classes="segmentOccupied" IsVisible="False" />
              <Border Grid.Column="1" Classes="segmentReclaimable" IsVisible="False" />
              <Border Grid.Column="2" Classes="segmentFree" IsVisible="False" />
            </Grid>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space5}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
              <Border Classes="legendSwatch" Background="{DynamicResource Occupied}" />
              <TextBlock Classes="monoNumber" Text="{Binding OccupiedText}" VerticalAlignment="Center" />
              <TextBlock Classes="caption" Text="in use" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
              <Border Classes="legendSwatch" Background="{DynamicResource Signal}" />
              <TextBlock Classes="monoNumber" Text="{Binding ReclaimableText}" VerticalAlignment="Center" />
              <TextBlock Classes="caption" Text="reclaimable" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
              <!-- Free is drawn in the track colour, so its swatch carries a hairline to stay visible on Paper. -->
              <Border Classes="legendSwatch" Background="{DynamicResource Sunken}"
                      BorderBrush="{DynamicResource Hairline}" BorderThickness="1" />
              <TextBlock Classes="monoNumber" Text="{Binding FreeText}" VerticalAlignment="Center" />
              <TextBlock Classes="caption" Text="free" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- Fallback when the drive can't be read: still report the figure, just without the bar. -->
        <StackPanel Spacing="2" IsVisible="{Binding !HasDriveInfo}">
          <TextBlock Classes="eyebrow" Text="RECLAIMABLE" />
          <TextBlock Classes="hero" Text="{Binding ReclaimableText}" />
          <TextBlock Classes="heroCaption" Text="{Binding StatusText}" />
        </StackPanel>

        <!--
          Progress. "N of M tools finished" is a real fraction, so the dashboard is the one screen that earns a
          determinate marker: one per tool in this run. The file count stays a count.
        -->
        <Border Classes="progressPanel" IsVisible="{Binding IsBusy}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space4}">
            <ItemsControl Grid.Column="0" ItemsSource="{Binding RunSteps}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="5" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pvm:DashboardToolViewModel">
                  <Border Classes="stepMarker" Classes.done="{Binding IsStepDone}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Grid.Column="1" Classes="mono" Text="{Binding ProgressText}" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <!-- What the last clean did, one line per tool, and anything that could not be done. -->
        <StackPanel Spacing="{StaticResource Space2}" IsVisible="{Binding HasRunReport}">
          <TextBlock Classes="eyebrow" Text="LAST RUN" />
          <Border Classes="card" Padding="{StaticResource RowPadding}">
            <ItemsControl ItemsSource="{Binding RunReport}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Classes="caption" Text="{Binding}" Margin="0,2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>

        <!--
          Tools. The tick decides whether a run scans and cleans the tool at all. "Show" lists the tool's own
          parts, each with the same tick its page has: one selection, two views onto it.
        -->
        <StackPanel Spacing="{StaticResource Space3}">
          <TextBlock Classes="eyebrow" Text="TOOLS IN THIS RUN" />
          <ItemsControl ItemsSource="{Binding Tools}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="pvm:DashboardToolViewModel">
                <Border Classes="card" Padding="{StaticResource RowPadding}">
                  <StackPanel Spacing="{StaticResource Space3}">

                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="{StaticResource Space3}">
                      <CheckBox Grid.Column="0" IsChecked="{Binding IsIncluded}" VerticalAlignment="Center"
                                IsEnabled="{Binding #Root.((pvm:DashboardViewModel)DataContext).IsIdle}"
                                AutomationProperties.Name="{Binding Title, StringFormat='Include {0} in the run'}" />

                      <Path Grid.Column="1" Classes="icon signal"
                            Data="{Binding Route, Converter={StaticResource RouteToGeometryConverter}}" />

                      <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Classes="rowTitle" Text="{Binding Title}" />
                        <TextBlock Classes="caption" Text="{Binding Caption}" />
                      </StackPanel>

                      <TextBlock Grid.Column="3" Classes="mono" Text="{Binding SummaryText}" VerticalAlignment="Center" />

                      <Button Grid.Column="4" Classes="inline" Content="{Binding ExpandText}"
                              Command="{Binding ToggleExpandedCommand}" IsVisible="{Binding HasParts}"
                              VerticalAlignment="Center" />

                      <!-- Only tools with a screen on this front end get an Open button; see RouteHasPageConverter. -->
                      <Button Grid.Column="5" Classes="inline" Content="Open" VerticalAlignment="Center"
                              IsVisible="{Binding Route, Converter={StaticResource RouteHasPageConverter}}"
                              Command="{Binding #Root.((pvm:DashboardViewModel)DataContext).OpenToolCommand}"
                              CommandParameter="{Binding Route}" />
                    </Grid>

                    <StackPanel IsVisible="{Binding ShowParts}" Spacing="{StaticResource Space2}">
                      <Border Classes="divider" />
                      <ItemsControl ItemsSource="{Binding Parts}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Spacing="{StaticResource Space2}" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="pvm:DashboardPartViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space3}">
                              <!-- The slot keeps its width when there is no tick, so titles stay aligned. -->
                              <Panel Grid.Column="0" Width="{StaticResource CheckBoxSize}" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding IsSelected}" IsVisible="{Binding CanSelect}"
                                          IsEnabled="{Binding #Root.((pvm:DashboardViewModel)DataContext).IsIdle}"
                                          AutomationProperties.Name="{Binding Title, StringFormat='Clean {0}'}" />
                              </Panel>
                              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="rowTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="caption" Text="{Binding Detail}" IsVisible="{Binding HasDetail}"
                                           TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <TextBlock Grid.Column="2" Classes="mono" Text="{Binding SizeText}" VerticalAlignment="Center" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Classes="caption" Text="{Binding MoreText}" IsVisible="{Binding ShowMore}" />
                    </StackPanel>

                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!--
          Every volume Large Files and Duplicates can walk, with the same tick as the Settings page. A ticked
          volume that isn't connected stays in the list, marked, so it never silently vanishes.
        -->
        <StackPanel Spacing="{StaticResource Space3}" IsVisible="{Binding HasVolumes}">
          <StackPanel Spacing="2">
            <TextBlock Classes="eyebrow" Text="DRIVES AND VOLUMES" />
            <TextBlock Classes="caption" Text="{Binding VolumesStatusText}" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Volumes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="pvm:VolumeChoiceViewModel">
                <Border Classes="card" Padding="{StaticResource RowPadding}">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{StaticResource Space3}">
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                              IsEnabled="{Binding #Root.((pvm:DashboardViewModel)DataContext).IsIdle}"
                              AutomationProperties.Name="{Binding DisplayName, StringFormat='Scan {0}'}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space2}" VerticalAlignment="Center">
                      <TextBlock Classes="rowTitle" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                      <Border Classes="pill quiet" IsVisible="{Binding IsAvailable}">
                        <TextBlock Text="{Binding KindText, Converter={StaticResource UppercaseConverter}}" />
                      </Border>
                      <Border Classes="pill attention" IsVisible="{Binding !IsAvailable}">
                        <TextBlock Text="{Binding KindText, Converter={StaticResource UppercaseConverter}}" />
                      </Border>
                    </StackPanel>
                    <Panel Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding IsAvailable}">
                      <Border Classes="meterTrack" />
                      <Border Classes="meterFill"
                              Width="{Binding UsedShare, Converter={StaticResource ShareToWidthConverter}, ConverterParameter={StaticResource MeterWidth}}" />
                    </Panel>
                    <TextBlock Grid.Column="3" Classes="mono" Text="{Binding SpaceText}" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <!--
      One primary action, as everywhere else. The two that remove things are danger. "Scan and clean" asks once,
      for everything. "Scan and auto clean" is the only action in the app that does not ask, and the line under
      the buttons says so.
    -->
    <StackPanel Grid.Row="2" Spacing="{StaticResource Space2}">
      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}">
        <Button Classes="primary" Content="Scan everything" Command="{Binding ScanEverythingCommand}" />
        <Button Classes="danger" Content="Scan and clean" Command="{Binding ScanAndCleanCommand}" />
        <Button Classes="danger" Content="Scan and auto clean" Command="{Binding ScanAndAutoCleanCommand}" />
        <Button Content="Stop scan" Command="{Binding CancelScanCommand}" IsVisible="{Binding IsScanning}" />
      </StackPanel>
      <TextBlock Classes="heroCaption" TextWrapping="Wrap"
                 Text="Scan everything deletes nothing. Scan and clean asks once before removing what is ticked. Scan and auto clean removes what is ticked without asking." />
    </StackPanel>

  </Grid>
</UserControl>
