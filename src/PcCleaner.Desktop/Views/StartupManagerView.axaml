<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pvm="using:PcCleaner.Presentation.ViewModels"
             x:Class="PcCleaner.Desktop.Views.StartupManagerView"
             x:DataType="pvm:StartupManagerViewModel"
             x:Name="Root">

  <!-- The Avalonia port of src/PcCleaner.App/Pages/StartupManagerPage.xaml, bound to the same view model. -->
  <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="{StaticResource Space4}" Margin="{StaticResource PagePadding}">

    <StackPanel Grid.Row="0" Spacing="2">
      <TextBlock Classes="eyebrow" Text="LAUNCH AT LOGIN" />
      <TextBlock Classes="hero" Text="{Binding ItemCountText}" />
      <TextBlock Classes="heroCaption" Text="{Binding StatusText}" />
    </StackPanel>

    <Border Grid.Row="1" Classes="progressPanel" IsVisible="{Binding IsBusy}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space3}">
        <ProgressBar Grid.Column="0" Classes="activity" />
        <TextBlock Grid.Column="1" Classes="mono" Text="{Binding StatusText}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Panel Grid.Row="2">
      <StackPanel Spacing="{StaticResource Space3}" Margin="0,32" MaxWidth="560"
                  HorizontalAlignment="Left" VerticalAlignment="Center"
                  IsVisible="{Binding !Items.Count}">
        <Path Classes="icon empty" Data="{StaticResource IconStartup}" />
        <TextBlock Classes="emptyTitle" Text="Nothing loaded yet" />
        <TextBlock Classes="emptyBody"
                   Text="Load to see the apps and services that start with your computer. Disabling one is reversible and never uninstalls anything." />
      </StackPanel>

      <ScrollViewer IsVisible="{Binding !!Items.Count}" Padding="0,0,12,0">
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="pvm:StartupItemViewModel">
              <Border Classes="rowCard">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource Space3}">

                  <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                      <TextBlock Classes="rowTitle" Text="{Binding Name}" VerticalAlignment="Center" />
                      <Border Classes="pill">
                        <TextBlock Text="{Binding SourceText, Converter={StaticResource UppercaseConverter}}" />
                      </Border>
                      <Border Classes="pill attention" IsVisible="{Binding RequiresElevation}">
                        <TextBlock Text="NEEDS ADMIN" />
                      </Border>
                    </StackPanel>
                    <TextBlock Classes="mono path" Text="{Binding CommandOrPath}" />
                  </StackPanel>

                  <!-- Enabled reads as Signal, disabled as a neutral. One class on the pill colours both the pill
                       and its label; MAUI needed the trigger repeated on the label because it can't reach a child. -->
                  <Border Grid.Column="1" Classes="pill quiet" Classes.on="{Binding IsEnabled}">
                    <TextBlock Text="{Binding StateText, Converter={StaticResource UppercaseConverter}}" />
                  </Border>

                  <!-- ToggleCommand already takes the row's item, so no click handler is needed. -->
                  <Button Grid.Column="2" Classes="inline" Content="{Binding ActionButtonText}" VerticalAlignment="Center"
                          Command="{Binding #Root.((pvm:StartupManagerViewModel)DataContext).ToggleCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Panel>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="{StaticResource Space3}">
      <Button Classes="primary" Content="Reload" Command="{Binding LoadCommand}" />
      <TextBlock Classes="heroCaption" VerticalAlignment="Center"
                 Text="Read fresh from your autostart entries each time you reload." />
    </StackPanel>

  </Grid>
</UserControl>
