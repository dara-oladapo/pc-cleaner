<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Avalonia front end, which is how PC Cleaner reaches Linux (see #1, #8). Standard MAUI has no Linux target,
    so this sits beside PcCleaner.App rather than replacing it, and both drive the same view models from
    PcCleaner.Presentation.

    Plain net10.0, so unlike PcCleaner.App it restores and builds on every OS. Today only Platforms/Linux exists. Its
    junk scanner is real (#10); the other services are stubs, each with its own issue (#11-#13). Only the Junk Files screen is wired so far — the
    rest of the screens and the design system are #9.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PcCleaner.Desktop</RootNamespace>
    <AssemblyName>PcCleaner.Desktop</AssemblyName>

    <!-- A binding path that doesn't exist on its x:DataType is a build error, not a blank field at runtime —
         the same guarantee MauiXamlInflator=SourceGen gives the MAUI app. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Pinned exactly, and every Avalonia package moves together: mixing Avalonia versions fails at runtime. -->
    <AvaloniaVersion>11.3.23</AvaloniaVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PcCleaner.Core\PcCleaner.Core.csproj" />
    <ProjectReference Include="..\PcCleaner.Presentation\PcCleaner.Presentation.csproj" />
  </ItemGroup>

</Project>
